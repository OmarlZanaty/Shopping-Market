<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Shoppingmarket</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>shoppingmarket</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>

	<key>NSLocationWhenInUseUsageDescription</key>
    <string>نحتاج موقعك لتحديد عنوان التوصيل</string>
	<!-- App Review rejected build 22 under Guideline 5.1.1(ii): the previous
	     string ("نستخدم الكاميرا لمسح الباركود والتقاط الصور") named the feature
	     but never said what the data is used FOR. Apple requires a concrete
	     example of the use, so both uses are spelled out explicitly. -->
	<key>NSCameraUsageDescription</key>
	<string>يستخدم التطبيق الكاميرا لمسح الباركود الموجود على المنتج فيضيفه مباشرة إلى سلة التسوق دون البحث عنه يدوياً، ولالتقاط صورة ترفقها بطلب الدعم لتوضيح مشكلة في طلبك — مثل تصوير منتج وصل تالفاً. لا تُستخدم الصور لأي غرض آخر ولا تُشارك مع أي جهة خارجية.</string>
	<!-- Not flagged by App Review, but it had the same defect as the camera
	     string above — strengthened pre-emptively rather than waiting for it to
	     become the next 5.1.1(ii) rejection. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>يطلب التطبيق الوصول إلى صورك لتختار صورة من الاستوديو وترفقها بطلب الدعم عند الإبلاغ عن مشكلة في طلبك، أو لتعيين صورة لحسابك الشخصي. لا يتم الوصول إلى مكتبة الصور إلا عند اختيارك صورة بنفسك.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>نستخدم Face ID لتسجيل الدخول الآمن إلى حسابك</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.676476995798-05j7g2e2ta451pik1ij436fqfndah4tg</string>
			</array>
		</dict>
		<!-- Firebase Phone Auth reCAPTCHA fallback. When the APNs silent-push app
		     check can't complete, FirebaseAuth verifies the app via a reCAPTCHA web
		     flow that redirects back through this scheme: GOOGLE_APP_ID from
		     GoogleService-Info.plist with ':' replaced by '-'. Without it the flow
		     has no way back into the app and verifyPhoneNumber's completion never
		     runs, hanging sign-in (App Review 2.1(a), builds 15 & 16). -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app-1-676476995798-ios-3160d76855981aed2d2177</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
